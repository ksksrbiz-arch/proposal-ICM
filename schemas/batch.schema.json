{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "batchId": {
      "type": "string",
      "minLength": 1
    },
    "instructionCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "rootAgent": {
      "type": "string",
      "minLength": 1
    },
    "assignment": {
      "type": "string",
      "minLength": 12
    },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "projectDir": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "enum": [
              "first-site",
              "redesign",
              "refinement"
            ]
          },
          "worker": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "projectId",
          "projectDir",
          "scope",
          "worker"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "batchId",
    "instructionCommit",
    "rootAgent",
    "assignment",
    "jobs"
  ]
}
