              "status": {
                "type": "string",
                "enum": [
                  "open",
                  "resolved",
                  "deferred"
                ]
              },
              "description": {
                "type": "string",
                "minLength": 12
              },
              "disposition": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "severity",
              "status",
              "description",
              "disposition"
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "schemaVersion",
        "fingerprint",
        "technical",
        "flows",
        "defects"
      ]
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "reviewedBy": {
          "type": "string",
          "minLength": 1
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "mobile": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ]
              },
              "desktop": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ]
              },
