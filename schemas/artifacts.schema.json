            "required": [
              "id",
              "entry",
              "description",
              "outcome",
              "destination",
              "behavior"
            ]
          },
          "minItems": 1
        }
      },
      "required": [
        "schemaVersion",
        "entries"
      ]
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "sourceDir": {
          "type": "string",
          "minLength": 1
        },
        "buildCommand": {
          "type": "string",
          "minLength": 1
        },
        "buildStamp": {
          "type": "string",
          "minLength": 1
        },
        "allowlist": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "configOnly": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "flowTestFiles": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "schemaVersion",
        "sourceDir",
        "buildCommand",
        "buildStamp",
        "allowlist",
        "configOnly",
        "flowTestFiles"
      ]
    },
    "qa": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "technical": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "flows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "passed": {
                "type": "boolean"
              },
