                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "path",
                  "sha256"
                ]
              }
            },
            "required": [
              "id",
              "passed",
              "evidence"
            ]
          },
          "minItems": 1
        },
        "defects": {
          "type": "array",
