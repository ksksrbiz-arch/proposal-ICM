        "deploymentId",
        "status",
        "deployedAt",
        "buildStamp",
        "stableUrl",
        "immutableUrl",
        "receipt",
        "hostedQa",
        "publicVerification"
      ]
    },
    "tracker": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "projectId": {
          "type": "string",
          "minLength": 1
        },
