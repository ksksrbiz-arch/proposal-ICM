              "maximum": 5
            },
            "artDirection": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "copyContent": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "mobile": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "journeys": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            },
            "finishAccessibility": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5
            }
          },
          "required": [
            "specificity",
            "artDirection",
            "copyContent",
            "mobile",
            "journeys",
            "finishAccessibility"
          ]
        },
        "comparison": {
          "type": "string",
          "minLength": 12
        },
        "observations": {
          "type": "string",
          "minLength": 12
        },
        "ownerInputs": {
