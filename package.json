{
  "name": "proposal-icm",
  "version": "1.0.0",
  "type": "module",
  "description": "Evidence-led context architecture and quality gates for business website proposals",
  "bin": { "proposal-icm": "./bin/icm.mjs" },
  "files": ["bin/", "lib/", "schemas/", ".icm/INDEX.md", ".icm/learning/LESSONS.json", "AGENTS.md", "CLAUDE.md", "GEMINI.md", "stages/", "docs/", "prompts/", "reference/", "templates/", "CHANGELOG.md"],
  "repository": { "type": "git", "url": "git+https://github.com/ksksrbiz-arch/proposal-ICM.git" },
  "homepage": "https://github.com/ksksrbiz-arch/proposal-ICM#readme",
  "bugs": { "url": "https://github.com/ksksrbiz-arch/proposal-ICM/issues" },
  "author": "1Commerce LLC",
  "license": "UNLICENSED",
  "keywords": ["icm", "agents", "website", "proposal", "quality-assurance", "context-management"],
  "publishConfig": { "access": "public", "registry": "https://registry.npmjs.org/" },
  "engines": { "node": ">=22" },
  "scripts": {
    "icm": "node bin/icm.mjs",
    "test": "node --test test/gates.test.mjs test/browser.test.mjs test/learning.test.mjs",
    "check": "node scripts/check-repo.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepublishOnly": "npm run check && npm test && npm run check:package",
    "test:browser": "node --test test/browser.test.mjs"
  },
  "dependencies": { "ajv": "8.20.0", "playwright": "1.64.1" }
}
